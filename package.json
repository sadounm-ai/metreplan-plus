{
  "name": "metreplan-plus",
  "version": "0.1.0",
  "private": true,
  "description": "MétréPlan+ : métré sur plans PDF piloté par la DPGF et contrôlé par le CCTP",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "start": "tsx server/index.ts --production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --external:electron --outfile=dist-electron/main.mjs",
    "app": "npm run build && npm run build:electron && electron .",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "4.21.2",
    "multer": "1.4.5-lts.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "electron": "38.8.6",
    "electron-builder": "26.18.0",
    "esbuild": "0.24.2",
    "tsx": "4.21.0",
    "typescript": "5.6.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  },
  "main": "dist-electron/main.mjs",
  "author": "MSBIM5D",
  "build": {
    "appId": "fr.msbim5d.metreplan",
    "productName": "MétréPlan+",
    "copyright": "MSBIM5D",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/zustand/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/build/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MetrePlan-Plus-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MétréPlan+",
      "menuCategory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "multiLanguageInstaller": false,
      "uninstallDisplayName": "MétréPlan+ ${version}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
